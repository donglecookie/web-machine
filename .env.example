# Required for Stagehand's AI operations.
# This version uses a LOCAL browser and does NOT require Browserbase.
# Groq offers a free API key (no credit card): https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# Alternative providers (use one, along with matching STAGEHAND_MODEL):
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional model override.
STAGEHAND_MODEL=groq/openai/gpt-oss-120b

# Optional: use any OpenAI-compatible endpoint (OpenRouter, a self-hosted server, etc.)
# instead of the built-in providers above. Stagehand doesn't support these natively, so this
# goes through a translation adapter (src/runtime/openaiCompatibleClient.ts). Takes priority
# over STAGEHAND_MODEL/GROQ_API_KEY when set. Unlike a specific built-in provider, there's no
# default baseURL/model to assume here - all three must be set together.
# Example values for OpenRouter (https://openrouter.ai/settings/keys):
# OPENAI_COMPATIBLE_API_KEY=your_api_key
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPATIBLE_MODEL=openai/gpt-4o-mini

# Optional: if Chromium is not auto-detected, set its executable path.
# CHROME_PATH=/usr/bin/chromium
