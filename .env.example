# Required for Stagehand's AI operations.
# This version uses a LOCAL browser and does NOT require Browserbase.
# Groq offers a free API key (no credit card): https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# Alternative providers (use one, along with matching STAGEHAND_MODEL):
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional model override.
STAGEHAND_MODEL=groq/openai/gpt-oss-120b

# Optional: use OpenRouter (or any other OpenAI-compatible endpoint) instead of the built-in
# providers above. Stagehand doesn't support OpenRouter natively, so this goes through a
# translation adapter (src/runtime/openaiCompatibleClient.ts). Takes priority over
# STAGEHAND_MODEL/GROQ_API_KEY when set.
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: if Chromium is not auto-detected, set its executable path.
# CHROME_PATH=/usr/bin/chromium
